# Retrieve the coordinates for a specific Maine well

PREFIX me-mgs-data: <http://sawgraph.spatialai.org/v1/me-mgs-data#>
prefix geo: <http://www.opengis.net/ont/geosparql#>
PREFIX kwg-ont: <http://stko-kwg.geog.ucsb.edu/lod/ontology/>
prefix me-mgs: <http://sawgraph.spatialai.org/v1/me-mgs#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT * WHERE {
    ?s rdf:type me-mgs:MGS-Well ;
       geo:hasGeometry/geo:asWKT ?wkt .
    FILTER(CONTAINS(str(?s), "144208"))
}
